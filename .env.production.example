# ===== TEMPLATE - JANGAN ISI DENGAN SECRET NYATA DI SINI =====
# Salin ke .env.production di server / mesin lokal, lalu isi nilainya.
# File .env.production sudah masuk .gitignore dan tidak boleh di-commit.
#
# Vite meng-inline HANYA variabel berawalan "VITE_" ke dalam bundle browser.
# Variabel tanpa awalan VITE_ di file ini diabaikan oleh Vite.

# ===== Endpoint backend =====
VITE_API_URL=https://api.ecgrhythmia.cloud
VITE_WS_URL=wss://api.ecgrhythmia.cloud/ws

# ===== Supabase (Auth) =====
# URL dan anon key bersifat publik dan aman untuk frontend.
# JANGAN pernah memakai service_role key di sini.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-public-key>

# ============================================================
# CATATAN PENTING
# Variabel berikut milik BACKEND (Rust) dan BUKAN bagian dari frontend.
# Backend membacanya dari .env miliknya sendiri, di repo backend.
# copied dari env backend:
#
#   HOST_IP, REST_PORT, WS_PORT
#   MQTT_BROKER, MQTT_PORT, MQTT_TOPIC, MQTT_USERNAME, MQTT_PASSWORD
#   JWT_SECRET, SQLITE_KEY, HOST_SQLITE_KEY
#   DB_PATH
#   DEFAULT_ADMIN_EMAIL, DEFAULT_ADMIN_PASSWORD
#   DATABASE_URL          <-- password database produksi
#   SUPABASE_JWT_SECRET   <-- bisa dipakai men forging token
#
# Semua nilai di atas adalah SECRET. Jangan masukkan ke repo manapun
# yang publik, dan rotasi bila pernah ikut ter-commit.
