# ===== Frontend (Vite) =====
VITE_API_URL=http://127.0.0.1:8081
VITE_WS_URL=ws://127.0.0.1:8080

# ===== Supabase (Auth + Database) =====
# Diperlukan agar aplikasi memakai Supabase. Jika kosong, aplikasi fallback ke REST API SQLite.
# PENTANG: anon key asli disimpan di file .env (gitignored), JANGAN di sini.
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-public-key Anda>

# ===== Migrasi Database (scripts/db-migration) =====
# Dipakai hanya oleh: npm run db:migrate
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role key - JANGAN dipakai di frontend/production build>
# SUPABASE_CONNECTION_STRING=postgresql://postgres.xxxx:<password>@aws-0-xx.pooler.supabase.com:5432/postgres
# SQLITE_DB_PATH=../backend/database.db

# ============================================================
# Environment backend (Rust) - BUKAN dibaca oleh frontend ini
# ============================================================
# Repo backend punya .env-nya sendiri. Daftar variabel di bawah hanya
# referensi nama field. JANGAN pernah di-commit nilainya.
# Salin dari: .env.production.example

# --- Server ---
# HOST_IP=127.0.0.1
# REST_PORT=8081
# WS_PORT=8080

# --- MQTT ---
# MQTT_BROKER=<broker-host>
# MQTT_PORT=8883
# MQTT_TOPIC=<topic-prefix>/#
# MQTT_USERNAME=<mqtt-user>
# MQTT_PASSWORD=<mqtt-password>            <-- SECRET

# --- Auth & enkripsi ---
# JWT_SECRET=<random-32-bytes-base64>      <-- SECRET
# SQLITE_KEY=<sqlite-key>
# HOST_SQLITE_KEY=<host-sqlite-key>        <-- SECRET

# --- Database ---
# DB_PATH=database.db
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>   <-- SECRET

# ===== Akun admin default ---
# DEFAULT_ADMIN_EMAIL=<admin-email>
# DEFAULT_ADMIN_PASSWORD=<admin-password>  <-- SECRET

# ===== App Versioning (for cache busting) =====
# Bump this on every deploy. When it changes, checkAppVersion() in src/main.tsx
# wipes localStorage + sessionStorage + all cookies and forces re-login.
# Dev default is 1.0.0. For VPS prod, set to 2 (or next integer) in .env.
VITE_APP_VERSION=1.0.0

# --- Supabase JWT (backend) ---
# SUPABASE_JWT_SECRET=<legacy-jwt-secret>   <-- SECRET
# CATATAN: Supabase project saat ini menandatangani access token dengan
# ES256 (asymmetric, lewat JWKS), bukan HS256. Backend sebaiknya
# memverifikasi lewat JWKS, bukan memakai SUPABASE_JWT_SECRET.
